# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Neon Auth v0.2+
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NextWave Crew

# USDC support payments on BNB Smart Chain
NEXT_PUBLIC_USDC_NETWORK=bsc
NEXT_PUBLIC_USDC_RECIPIENT_ADDRESS=0xf8766be6d62f80c7e5f37af4a07f4faca0dac9fe
# Public BSC RPC is suitable for development. Use a dedicated provider for production traffic.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Binance Pay
NEXT_PUBLIC_BINANCE_PAY_URL=https://app.binance.com/uni-qr/2VuuSfAT
NEXT_PUBLIC_BINANCE_PAY_NAME=DreamFaith
